---
layout: null
permalink: /feed.xml
sitemap: false
---
{% assign profile = site.data.profile %}

<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
<title>{{ site.title | xml_escape }} — all</title><subtitle>{{ profile.description_en | default: site.description | xml_escape }}</subtitle><link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/atom+xml"/><link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/><id>{{ '/feed.xml' | absolute_url }}</id>
<updated>{% if site.posts.first %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated><author><name>{{ profile.name | default: site.author.name | xml_escape }}</name></author>
{% for post in site.posts limit: 30 %}<entry xml:lang="{{ post.lang | default: site.default_lang }}"><title>{{ post.title | xml_escape }}</title><link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/><id>{{ post.url | absolute_url }}</id><published>{{ post.date | date_to_xmlschema }}</published><updated>{% if post.updated %}{{ post.updated | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</updated><summary type="html">{{ post.summary | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>{% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>{% endfor %}</entry>{% endfor %}
</feed>
