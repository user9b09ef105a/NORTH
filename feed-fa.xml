---
layout: null
permalink: /feed-fa.xml
sitemap: false
---
{% assign profile = site.data.profile %}
{% assign feed_posts = site.posts | where: 'lang', 'fa' %}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="fa">
<title>{{ site.title | xml_escape }} — فارسی</title><subtitle>{{ profile.description_fa | default: site.description_fa | default: site.description | xml_escape }}</subtitle><link href="{{ '/feed-fa.xml' | absolute_url }}" rel="self" type="application/atom+xml"/><link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html"/><id>{{ '/feed-fa.xml' | absolute_url }}</id>
<updated>{% if feed_posts.first %}{{ feed_posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated><author><name>{{ profile.name | default: site.author.name | xml_escape }}</name></author>
{% for post in feed_posts limit: 30 %}<entry xml:lang="{{ post.lang | default: site.default_lang }}"><title>{{ post.title | xml_escape }}</title><link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/><id>{{ post.url | absolute_url }}</id><published>{{ post.date | date_to_xmlschema }}</published><updated>{% if post.updated %}{{ post.updated | date_to_xmlschema }}{% else %}{{ post.date | date_to_xmlschema }}{% endif %}</updated><summary type="html">{{ post.summary | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>{% for tag in post.tags %}<category term="{{ tag | xml_escape }}"/>{% endfor %}</entry>{% endfor %}
</feed>
