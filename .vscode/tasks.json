  "inputs": [
    {
      "id": "contentType",
      "type": "pickString",
      "description": "Content type",
      "options": [
        "post",
        "project",
        "note",
        "signal",
        "image",
        "audio",
        "video",
        "document",
        "tweet"
      ],
      "default": "post"
    },
    {
      "id": "mediaContentType",
      "type": "pickString",
      "description": "Media content type",
      "options": [
        "image",
        "audio",
        "video",
        "document",
        "tweet"
      ],
      "default": "image"
    },
    {
      "id": "contentLang",
      "type": "pickString",
      "description": "Content language / زبان محتوا",
      "options": [
        "en",
        "fa"
      ],
      "default": "en"
    },
    {
      "id": "contentDomain",
      "type": "pickString",
      "description": "Domain / حوزه",
      "options": [
        "software",
        "architecture",
        "ai",
        "systems",
        "research",
        "product",
        "design",
        "business",
        "career",
        "knowledge",
        "general"
      ],
      "default": "general"
    },
    {
      "id": "contentNature",
      "type": "pickString",
      "description": "Nature / ماهیت",
      "options": [
        "analysis",
        "guide",
        "research",
        "case-study",
        "build-log",
        "reference",
        "opinion",
        "learning",
        "journal",
        "announcement"
      ],
      "default": "analysis"
    },
    {
      "id": "mediaType",
      "type": "pickString",
      "description": "Media type (usually text for normal content)",
      "options": [
        "text",
        "image",
        "audio",
        "video",
        "document",
        "link",
        "mixed"
      ],
      "default": "text"
    },
    {
      "id": "contentTitle",
      "type": "promptString",
      "description": "Title"
    },
    {
      "id": "contentSlug",
      "type": "promptString",
      "description": "Optional URL slug (ASCII; useful for Persian titles)",
      "default": ""
    },
    {
      "id": "translationKey",
      "type": "promptString",
      "description": "Optional translation key shared by EN/FA versions",
      "default": ""
    },
    {
      "id": "contentTags",
      "type": "promptString",
      "description": "Tags (comma separated)",
      "default": ""
    },
    {
      "id": "contentSummary",
      "type": "promptString",
      "description": "Short public summary",
      "default": ""
    },
    {
      "id": "mediaPath",
      "type": "promptString",
      "description": "Local file path or public URL"
    },
    {
      "id": "draftName",
      "type": "promptString",
      "description": "Draft filename, e.g. draft-idea.md"
    },
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Git commit message",
      "default": "publish: update north"
    },
    {
      "id": "siteUrl",
      "type": "promptString",
      "description": "Live Pages URL, e.g. https://USER.github.io/north"
    },
    {
      "id": "dataPackDestination",
      "type": "promptString",
      "description": "Optional output ZIP path. Leave blank for .north/exports default.",
      "default": ""
    },
    {
      "id": "dataPackPath",
      "type": "promptString",
      "description": "NORTH data pack ZIP path to import"
    },
    {
      "id": "cleanSourceDestination",
      "type": "promptString",
      "description": "Optional clean source ZIP path. Leave blank for .north/exports default.",
      "default": ""
    },
    {
      "id": "upgradeWorkspacePath",
      "type": "promptString",
      "description": "Upgrade workspace folder path. Leave blank when creating to use a sibling timestamped folder.",
      "default": ""
    },
    {
      "id": "bodyFilePath",
      "type": "promptString",
      "description": "Existing Markdown/text body file path"
    }
  ]
